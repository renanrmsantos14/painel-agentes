{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Painel Agentes",
  "version": "../package.json",
  "identifier": "br.com.betinhos.painel-agentes",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:45213",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Painel Agentes",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
